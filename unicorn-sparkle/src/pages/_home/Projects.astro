---
import { t } from 'i18n:astro'
import CardProject from '@components/CardProject.astro'
import { proyectosDestacados } from '@data/cargar-proyectos'

// Detectar idioma actual
const lang = Astro.url.pathname.includes('/en') ? 'en' : 'es'

// Título de sección desde i18n
const { title } = t('projects', { returnObjects: true })

// Proyectos leídos automáticamente de src/data/proyectos/*.json
const proyectos = proyectosDestacados()
---

<section id={title.toLowerCase()} class="projects">
  <h2>
    <span>{title}</span>
  </h2>
  {
    proyectos.map((p) => (
      <CardProject
        title={p.titulo}
        description={p.descripcion[lang]}
        techs={p.tecnologias}
        media={p.media}
        codeLabel={p.etiquetas.codigo[lang]}
        previewLabel={p.etiquetas.demo[lang]}
        codeUrl={p.enlaces.codigo}
        previewUrl={p.enlaces.demo}
      />
    ))
  }
</section>

<style>
  .projects {
    padding-bottom: 120px;

    & h2 {
      display: flex;
      gap: 24px;
      justify-content: center;
      align-items: center;
      white-space: nowrap;
      margin-bottom: 86px;

      @media (width >= 768px) {
        justify-content: start;

        &::after {
          content: '';
          display: block;
          width: 100%;
          height: 1px;
          background-color: var(--border-color);
        }
      }

      & span {
        order: 1;
      }
    }
  }
</style>
